# ============================================================
# Mesio Restaurant Bot — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- REQUIRED (app crashes without these) ---

# PostgreSQL connection string (asyncpg-compatible)
# Runtime app uses this URL — must connect as mesio_app (non-superuser) to enforce RLS.
DATABASE_URL=postgresql://mesio_app:password@localhost:5432/mesio

# Superuser URL used ONLY by Alembic migrations (Phase 1 RLS).
# Runtime app MUST use DATABASE_URL (mesio_app non-superuser role) to enforce RLS.
# DATABASE_URL_ADMIN=postgresql://postgres:PASS@HOST:PORT/DB

# Anthropic API key — used by the AI bot for every message
ANTHROPIC_API_KEY=sk-ant-api03-replace-me

# Admin key for /health/metrics, /monitoring, /analytics, and superadmin routes
ADMIN_KEY=replace-with-a-long-random-secret


# --- REQUIRED for WhatsApp (bot is completely dead without these) ---

# Found in Meta Developer Console → App → App Secret
META_APP_SECRET=replace_with_meta_app_secret

# Token you set in Meta's Webhook configuration panel (you choose this value)
META_VERIFY_TOKEN=replace_with_your_chosen_verify_token

# WhatsApp System User access token (permanent token recommended for production)
META_ACCESS_TOKEN=EAAreplace_with_meta_access_token

# Meta API version — update only when migrating to a newer Graph API version
META_API_VERSION=v20.0

# WhatsApp Phone Number ID (from Meta Developer Console → WhatsApp → API Setup)
META_PHONE_NUMBER_ID=replace_with_phone_number_id


# --- REQUIRED for dashboard (CORS will break without this) ---

# Public domain of this deployment, no trailing slash (used for CORS and WebAuthn RP_ID)
APP_DOMAIN=yourdomain.com

# Comma-separated list of allowed CORS origins (defaults to APP_DOMAIN if omitted)
# APP_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com


# --- RECOMMENDED (degraded behaviour without these) ---

# Redis connection string — enables shared state across multiple uvicorn workers
# Without this: NPS flows, checkout proposals, cart locks, rate limits, and
# scheduler leader election fall back to in-process dicts (single-worker only)
REDIS_URL=redis://localhost:6379/0

# Wompi payment gateway keys (required if reservation deposits or online payment is used)
WOMPI_PUBLIC_KEY=pub_test_replace_with_wompi_public_key
WOMPI_INTEGRITY_SECRET=replace_with_wompi_integrity_secret

# Wompi webhook signing secret (for validating Wompi payment event webhooks)
WOMPI_EVENTS_SECRET=replace_with_wompi_events_secret


# --- OPTIONAL FEATURES ---

# Webhook URL for operational alerts (Slack/Discord incoming webhook format)
# Receives POST {"text": "[SEVERITY] ...", "severity": "...", "key": "...", "timestamp": "..."}
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/replace/with/real_url

# CRM WhatsApp Phone Number ID (separate from the main bot number, if used for CRM campaigns)
# CRM_PHONE_NUMBER_ID=replace_with_crm_phone_number_id

# Set to "inbox" to run this service as a dedicated webhook inbox worker instead of the web server
# Used in Railway to deploy a separate worker service alongside the web service
# WORKER_MODE=inbox

# Set to "1" to disable the embedded inbox worker inside the web service
# Useful when WORKER_MODE=inbox service handles all inbox processing
# DISABLE_EMBEDDED_WORKER=1

# Override the Anthropic model used for fast/short responses (default: claude-haiku-4-5-20251001)
# BOT_MODEL_FAST=claude-haiku-4-5-20251001

# Override the Anthropic model used for complex/precise responses (default: claude-sonnet-4-6)
# BOT_MODEL_PRECISE=claude-sonnet-4-6

# Maximum tokens the LLM can generate per bot response (default: 2048)
# BOT_MAX_TOKENS=2048
